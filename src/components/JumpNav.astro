---
/**
 * "On this page" chips in a grid whose row count depends only on the container width, never on
 * text width, so every section is one visible tap away on a phone (no hidden sideways scroll) and a
 * late web-font swap cannot re-wrap the rows and shift the page: two columns on phones (a long label
 * may take two lines inside the 44px chip, which holds two lines without growing), equal columns of
 * at least 10.5rem (wider than any label) from 640px.
 */
interface Props {
  items: { href: string; label: string }[];
  label?: string;
  class?: string;
}
const { items, label = 'On this page', class: cls } = Astro.props;
---

<nav aria-label={label} class={cls}>
  <ul class="grid grid-cols-2 gap-2 sm:grid-cols-[repeat(auto-fill,minmax(10.5rem,1fr))]">
    {
      items.map((l) => (
        <li class="min-w-0">
          <a
            href={l.href}
            class="cond flex h-11 w-full items-center justify-center rounded-chip border border-control px-2 text-center text-[0.9375rem] leading-[1.125rem] font-bold tracking-[0.05em] uppercase transition-colors hover:bg-raised sm:px-3 sm:whitespace-nowrap"
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
