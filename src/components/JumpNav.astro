---
/**
 * "On this page" chips. One scrollable row below 1024px (so the late web-font swap can never
 * re-wrap it and shift the page), wrapping from 1024px. Condensed 700, the preloaded weight.
 */
interface Props {
  items: { href: string; label: string }[];
  label?: string;
  class?: string;
}
const { items, label = 'On this page', class: cls } = Astro.props;
---

<nav aria-label={label} class:list={['-mx-gutter lg:mx-0', cls]}>
  <ul class="flex gap-2 overflow-x-auto px-gutter pb-1 [scrollbar-width:none] lg:flex-wrap lg:px-0">
    {
      items.map((l) => (
        <li class="flex-none">
          <a
            href={l.href}
            class="cond inline-flex min-h-10 items-center rounded-chip border border-control px-3 text-[0.9375rem] font-bold tracking-[0.05em] whitespace-nowrap uppercase transition-colors hover:bg-raised"
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
