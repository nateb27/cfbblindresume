---
/**
 * "On this page" chips. Phones: a grid whose row count depends only on the container width, never
 * on text width, so every section is one visible tap away (no hidden sideways scroll) and a late
 * web-font swap cannot re-wrap the rows: three columns from 375px (two below), each chip printing
 * its `short` label when it has one, so labels sit on one line instead of wrapping ragged. From
 * 640px the chips size to their text and flow in a row (an index, not a wall of buttons): a 1px
 * rule, not the control edge. Pass a max-width class to keep the row inside a reading column.
 */
interface Props {
  items: { href: string; label: string; short?: string }[];
  label?: string;
  class?: string;
}
const { items, label = 'On this page', class: cls } = Astro.props;
---

<nav aria-label={label} class={cls}>
  <ul class="grid grid-cols-2 gap-2 min-[375px]:grid-cols-3 sm:flex sm:flex-wrap">
    {
      items.map((l) => (
        <li class="min-w-0">
          <a
            href={l.href}
            class="flex h-11 w-full items-center justify-center rounded-chip border border-control px-2 text-center text-[0.875rem] leading-4 font-semibold transition-colors hover:bg-raised sm:w-auto sm:border-line-strong sm:px-3.5 sm:text-[0.9375rem] sm:leading-[1.125rem] sm:whitespace-nowrap sm:hover:border-fg"
          >
            {l.short ? (
              <>
                <span class="sm:hidden" aria-hidden="true">
                  {l.short}
                </span>
                <span class="max-sm:sr-only">{l.label}</span>
              </>
            ) : (
              l.label
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
