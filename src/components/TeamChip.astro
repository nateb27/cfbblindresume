---
/**
 * Inline team mark for tables, lists and prose (DESIGN §10 `.team-chip`): a 10x18 index tab with
 * the secondary rule + the name in Archivo 600, sentence case. FBS teams link to their page;
 * non-FBS opponents are plain text on a neutral tab.
 */
import type { WeekFile } from '@lib/types';
import { teamVars } from '../styles/tokens';
import { teamHref } from './site';

interface Props {
  week: WeekFile;
  slug: string;
  /** Non-FBS opponent (looked up in week.opponents). */
  nonFbs?: boolean;
  /** Override the visible text (defaults to the team name). */
  label?: string;
  /** In a table row: grow the link's hit area to the full row height (44px) without moving layout. */
  tap?: boolean;
  class?: string;
}
const { week, slug, nonFbs = false, label, tap = false, class: cls } = Astro.props;
const t = nonFbs ? undefined : week.teams[slug];
const o = nonFbs ? week.opponents[slug] : undefined;
if (!t && !o) throw new Error(`TeamChip: unknown team ${slug}`);
const name = label ?? t?.name ?? o!.name;
---

{
  t ? (
    <a href={teamHref(t.slug)} class:list={['team-chip hover:underline hover:decoration-2 hover:underline-offset-4', tap && 'team-chip-tap', cls]} style={teamVars(t.colors)}>
      {name}
    </a>
  ) : (
    <span class:list={['team-chip', cls]} style="--team-bg: var(--color-raised-2)">
      {name}
    </span>
  )
}
