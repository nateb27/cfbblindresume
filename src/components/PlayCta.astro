---
/**
 * A static pitch for the blind game where the debate is hottest (compare, bubble and team pages):
 * one question, one line, one button to /#play. Never inside an ad slot; no JavaScript. It opens
 * with a miniature redacted card header; `record` is the real record of the team the question
 * names (data-driven, never a placeholder), and the header shows none when the question names no
 * single team.
 */
interface Props {
  heading: string;
  body: string;
  /** Record of the team the question is about, e.g. "6-2". */
  record?: string;
  class?: string;
}
const { heading, body, record, class: cls } = Astro.props;
---

<div class:list={['play-pitch flex flex-col gap-4 rounded-card border border-line-strong bg-surface p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8', cls]}>
  <div class="pitch-file" aria-hidden="true">
    <span class="file-letter">A</span>
    <span class="pitch-file-title"><span class="label-caps text-[0.75rem] leading-[0.875rem] text-fg-muted">Team A</span><span data-redacted></span></span>
    {record && <span class="pitch-file-rec">{record}</span>}
  </div>
  <div class="max-w-read sm:flex-1">
    <p class="label-caps text-fg-muted">The blind resume game</p>
    <p class="mt-1 text-heading">{heading}</p>
    <p class="mt-1.5 text-[0.9375rem] leading-6 text-fg-muted">{body}</p>
  </div>
  <a href="/#play" class="btn btn-primary flex-none self-start sm:self-center">Rank them blind</a>
</div>
