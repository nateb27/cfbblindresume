---
/**
 * A static pitch for the blind game where the debate is hottest (compare, bubble and team pages):
 * one question, one line, one button to /#play. Never inside an ad slot; no JavaScript.
 */
interface Props {
  heading: string;
  body: string;
  class?: string;
}
const { heading, body, class: cls } = Astro.props;
---

<div class:list={['flex flex-col gap-4 rounded-card border border-line bg-surface p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8', cls]}>
  <div class="max-w-read">
    <p class="label-caps text-fg-muted">The blind resume game</p>
    <p class="cond mt-1 text-[1.5rem] leading-7 font-bold uppercase">{heading}</p>
    <p class="mt-1.5 text-[0.9375rem] leading-6 text-fg-muted">{body}</p>
  </div>
  <a href="/#play" class="btn btn-primary flex-none self-start sm:self-center">Rank them blind</a>
</div>
