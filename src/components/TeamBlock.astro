---
/**
 * Team identity (DESIGN §10): a cover (primary color block, sentence-case name in the
 * contrast-picked ink, 4px secondary rule) or, with a seed, an index tab (the seed on a small
 * team-color tab, the name typed in ink on paper). Links to the team page unless `href` is false.
 * Only the name and the optional meta (record) sit on the team color.
 */
import type { Team } from '@lib/types';
import { teamVars } from '../styles/tokens';
import { teamHref } from './site';
import type { HeroNameFit } from './text-metrics';

type Size = 'slot' | 'row' | 'tile' | 'reveal' | 'hero';
interface Props {
  team: Pick<Team, 'slug' | 'name' | 'colors'>;
  size?: Size;
  /** Seed / rank numeral in the left plate. */
  seed?: number | string;
  /** Right-aligned meta on the block (e.g. record). */
  meta?: string;
  /** false = not a link (e.g. the page's own hero). */
  href?: string | false;
  /** Heading element for the name (hero uses h1). */
  nameAs?: 'span' | 'h1' | 'h2' | 'h3';
  /** Hero only: build-time name fit (heroNameFit) so the name shrinks or splits, never truncates. */
  nameFit?: HeroNameFit;
  class?: string;
}
const { team, size = 'row', seed, meta, href = teamHref(team.slug), nameAs = 'span', nameFit, class: cls } = Astro.props;

const height = {
  slot: 'h-9 pr-2.5',
  row: 'min-h-12 pr-3',
  tile: 'min-h-16 pr-3',
  reveal: 'h-14 pr-4',
  hero: 'min-h-[4.5rem] pr-4 sm:min-h-24 sm:pr-6 [container-type:inline-size]',
}[size];
const nameCls = {
  slot: 'truncate text-[0.9375rem] leading-4',
  row: 'py-1 text-[1.125rem] leading-[1.125rem] [overflow-wrap:anywhere]',
  tile: 'text-team line-clamp-2',
  reveal: 'truncate text-heading',
  hero: nameFit ? 'hero-name' : 'truncate text-title sm:text-display',
}[size];
// One fixed plate width per size (no padding): a two-digit seed never shifts its name right.
const plate = { slot: 'w-10 px-0 text-[1.125rem]', row: 'w-10 px-0 text-[1.375rem]', tile: 'w-10 px-0 text-[1.375rem]', reveal: 'min-w-12 text-[1.75rem]', hero: '' }[size];
const metaCls = {
  slot: 'text-[0.9375rem]',
  row: 'text-[1.0625rem]',
  tile: 'text-[1.0625rem]',
  reveal: 'text-[1.25rem]',
  hero: 'text-[1.25rem] leading-6 sm:text-[1.75rem] sm:leading-8',
}[size];
const pad = seed !== undefined ? 'pl-2.5' : size === 'hero' ? 'pl-4 sm:pl-6' : 'pl-3';
const Tag = href ? 'a' : 'div';
const Name = nameAs;
---

<Tag
  href={href || undefined}
  class:list={['team-block', height, cls]}
  style={teamVars(team.colors)}
  data-variant={seed !== undefined && size !== 'reveal' ? 'tab' : 'cover'}
  data-size={size}
  data-meta={meta ? '' : undefined}
>
  {seed !== undefined && <span class:list={['seed-plate', plate]}>{seed}</span>}
  <Name class:list={['team-name min-w-0 flex-1', pad, nameCls]} style={nameFit?.style}>
    {
      nameFit && nameFit.parts.length === 2 ? (
        <>
          <span class="hero-line">{nameFit.parts[0]}</span> <span class="hero-line">{nameFit.parts[1]}</span>
        </>
      ) : (
        team.name
      )
    }
  </Name>
  {meta && <span class:list={['team-meta ml-3 flex-none text-right', metaCls]}><slot name="meta">{meta}</slot></span>}
  <slot />
</Tag>
