---
/**
 * The un-blinded resume card (compare page): the same content the blind game card shows, with the
 * team's lower-third on top instead of the redacted header. Static HTML, no JS.
 */
import { gameRows } from '@lib/data';
import type { WeekFile } from '@lib/types';
import QualityWins from './QualityWins.astro';
import ResumeStrip from './ResumeStrip.astro';
import Stars from './Stars.astro';
import TeamBlock from './TeamBlock.astro';
import TeamChip from './TeamChip.astro';
import TeamLink from './TeamLink.astro';
import { METRICS, SITE_LABELS, bandKey, confRecord, fill, oppWithRank, record, resumeHighlights, signed } from './site';

interface Props {
  week: WeekFile;
  slug: string;
  headingLevel?: 'h2' | 'h3';
  /** Resume strip column (px): the compare page passes the wider of the two teams' so both strips share one scale. */
  stripCol?: number;
  /** Resume strip slots: the compare page passes the longer season, so both strips share one grid. */
  stripSlots?: number;
}
const { week, slug, headingLevel = 'h2', stripCol, stripSlots } = Astro.props;
const t = week.teams[slug]!;
const n = week.fbsCount;
const rows = gameRows(week, slug);
const metrics = [
  { ...METRICS.sor, rank: t.ranks.sor, span: true },
  { ...METRICS.off, rank: t.ranks.off, span: false },
  { ...METRICS.def, rank: t.ranks.def, span: false },
  { ...METRICS.sos, rank: t.ranks.sos, span: true },
];
const independent = week.playoffFormats.some((f) => f.nonConferences.includes(t.conference));
const hl = resumeHighlights(week, slug);
const lines = [
  { k: 'Best win', g: hl.bestWin, none: 'No wins yet' },
  { k: 'Worst loss', g: hl.worstLoss, none: 'Unbeaten' },
];
---

<article class="flex flex-col overflow-hidden rounded-card border border-line-strong bg-surface" aria-label={`${t.name} resume`}>
  <TeamBlock team={t} size="reveal" meta={record(t)} class="rounded-none" nameAs={headingLevel} />
  <p class="flex flex-wrap gap-x-3 gap-y-1 border-b border-line px-4 py-2.5 text-sm text-fg-muted">
    <span>{independent ? t.conference : `${t.conference} ${confRecord(t)}`}</span>
    {week.committee && <span>Committee <b class="cond text-[1.0625rem] text-fg">{t.ranks.committee === null ? 'NR' : `#${t.ranks.committee}`}</b></span>}
    <span>FEI overall <b class="cond text-[1.0625rem] text-fg">#{t.ranks.fei}</b></span>
  </p>
  <dl class="grid grid-cols-2 gap-x-5 gap-y-3 px-4 pt-3 pb-4">
    {
      metrics.map((m) => (
        <div class:list={['grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-2', m.span && 'col-span-2']}>
          <dt class="label-caps text-fg-muted">{m.label}</dt>
          <dd class="cond text-stat">#{m.rank}</dd>
          <dd class="meter col-span-2 mt-1.5" data-tier={bandKey(m.rank)} style={`--fill:${fill(m.rank, n)}`}>
            <span />
          </dd>
        </div>
      ))
    }
  </dl>
  {/* A size container: in a narrow card (under 19rem, phones under 370px) each label sits above its value, as on the team page, so the value gets the card's full width and an opponent's name ("Texas A&M") is not split across lines. */}
  <dl class="@container flex flex-col gap-1.5 border-t border-line px-4 py-3 text-sm">
    {
      hl.vsCommittee && (
        <div class="flex items-baseline gap-2 @max-[19rem]:flex-col @max-[19rem]:items-start @max-[19rem]:gap-0.5">
          <dt class="label-caps w-24 flex-none text-fg-muted @max-[19rem]:w-auto">vs CFP top {hl.vsCommittee.n}</dt>
          <dd class="cond text-[1.0625rem] font-bold">
            {hl.vsCommittee.w + hl.vsCommittee.l === 0 ? <span class="text-fg-muted">No games</span> : `${hl.vsCommittee.w}-${hl.vsCommittee.l}`}
          </dd>
        </div>
      )
    }
    {
      lines.map(({ k, g, none }) => {
        const o = g ? oppWithRank(week, g) : null;
        return (
          <div class="flex items-baseline gap-2 @max-[19rem]:flex-col @max-[19rem]:items-start @max-[19rem]:gap-0.5">
            <dt class="label-caps w-24 flex-none text-fg-muted @max-[19rem]:w-auto">{k}</dt>
            <dd class="min-w-0">
              {g && o ? (
                <>
                  <span class="result-chip mr-1.5 align-middle" data-result={g.result}>
                    <span>{g.result}</span>
                    <span>{signed(g.margin)}</span>
                  </span>
                  {g.site === 'away' ? 'at ' : 'vs '}
                  {o.slug ? <TeamLink team={{ slug: o.slug, name: o.name }} /> : o.name}
                  {/* The rank in parentheses, kept whole (the space before it stays outside, so the whole parenthetical can wrap): a wrapped line may start with "(FEI #23)" or "(neutral, FEI #23)", never with a stray dot or half of it. */}
                  <>{' '}<span class="whitespace-nowrap text-fg-muted">({g.site === 'neutral' ? 'neutral, ' : ''}{o.rank})</span></>
                </>
              ) : (
                <span class="text-fg-muted">{none}</span>
              )}
            </dd>
          </div>
        );
      })
    }
  </dl>
  <section class="border-t border-line px-4 py-3">
    <h3 class="label-caps text-fg-muted">Quality wins (by FEI rank)</h3>
    <QualityWins week={week} slug={slug} class="mt-1.5" />
    <h3 class="label-caps mt-3 text-fg-muted">Season in order</h3>
    <ResumeStrip week={week} slug={slug} minCol={stripCol} slots={stripSlots} class="mt-2" />
  </section>
  <section class="border-t border-line px-4 pt-3 pb-2">
    <h3 class="label-caps text-fg-muted">Game log, toughest first</h3>
    {/* A size container: in a narrow card (under 19rem, e.g. a 320px phone) the site and band move under the opponent's name, so a long single-word name never runs into them. */}
    <ol class="@container mt-1">
      {
        rows.map((g) => (
          <li class="grid min-h-9 grid-cols-[auto_minmax(0,1fr)_auto_auto] items-center gap-x-2.5 border-t border-line py-1 first:border-t-0 @max-[19rem]:grid-cols-[auto_minmax(0,1fr)_auto]">
            <Stars stars={g.tier.stars} label={g.tier.label} class="@max-[19rem]:col-start-1 @max-[19rem]:row-span-2 @max-[19rem]:row-start-1" />
            <span class="min-w-0 @max-[19rem]:col-start-2 @max-[19rem]:row-start-1">
              <TeamChip week={week} slug={g.opp.slug} nonFbs={!g.opp.fbs} />
            </span>
            <span class="text-right text-[0.8125rem] leading-4 text-fg-muted @max-[19rem]:col-start-2 @max-[19rem]:row-start-2 @max-[19rem]:pl-[1.125rem] @max-[19rem]:text-left @max-[19rem]:text-[0.75rem]">
              {SITE_LABELS[g.site]}
              <span class="hidden @max-[19rem]:inline" aria-hidden="true">{' · '}</span>
              <span class="block text-[0.75rem] @max-[19rem]:inline" aria-hidden="true">{g.tier.label.replace(/ team$/, '')}</span>
            </span>
            <span class="result-chip @max-[19rem]:col-start-3 @max-[19rem]:row-span-2 @max-[19rem]:row-start-1" data-result={g.result}>
              <span>{g.result}</span>
              <span>{signed(g.margin)}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</article>
