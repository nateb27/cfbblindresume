---
/**
 * Resume strip (SPEC card + team page): one tick per game in date order on a baseline, its height
 * the opponent's current tier (a tiny bar chart in toner), with the opponent above (@ = away,
 * vs = neutral) and the result letter (win/loss colour) and margin under it.
 * Static HTML + CSS, no JS (src/styles/season-strip.css). It never scrolls sideways: the games
 * share the width it is given (up to 5rem each), and when one row of `col`-wide columns does not
 * fit it wraps into two balanced rows (games 1-6 / 7-12), then three. Columns are as wide as the
 * labels need (resume-strip.ts), or `minCol` when that is wider; `slots` reserves columns for at
 * least that many games (the compare page gives both cards the same `minCol` and `slots`, so the
 * two strips read as one chart). Ticks grow with the strip (1.2x on phones, 2x from 30rem), and
 * so do the samples of the optional key under it.
 */
import type { WeekFile } from '@lib/types';
import { tierKey } from '../styles/tokens';
import '../styles/season-strip.css';
import { stripCol, stripFit, stripGames, stripLabel } from './resume-strip';
import { fmtShortDate, signed, siteVs } from './site';

interface Props {
  week: WeekFile;
  slug: string;
  /** The narrowest column (px). */
  minCol?: number;
  /** Reserve columns for at least this many games. */
  slots?: number;
  /** Print the "Tick height = opponent tier" key under the strip, its samples at the strip's scale. */
  legend?: boolean;
  class?: string;
}
const { week, slug, minCol = 0, slots = 0, legend = false, class: cls } = Astro.props;
const games = stripGames(week, slug);
const t = week.teams[slug]!;
const col = Math.max(minCol, stripCol(week, slug));
const n = Math.max(1, slots, games.length);
const fit = stripFit(n, col);
const summary = `${t.name} season in order: ${games
  .map((g) => `${g.result === 'W' ? 'win' : 'loss'} ${siteVs(g.site, g.opp.name)}, ${g.tier.label}, ${g.pf}-${g.pa}`)
  .join('; ')}.`;
---

<div class:list={['season-strip-wrap', cls]}>
  <div class="season-strip" role="img" aria-label={summary} style={`--n:${n};--half:${fit.half};--third:${fit.third};--col:${col}px`} data-fit-1={fit.one} data-fit-2={fit.two}>
    {
      games.map((g) => (
        <span class="season-game" title={`${fmtShortDate(g.date)} · ${siteVs(g.site, g.opp.name)} (${g.tier.label}) · ${g.result} ${g.pf}-${g.pa}`}>
          <span class="season-opp">{stripLabel(week, g)}</span>
          <span class="season-tick">
            <span class="tier-dot" data-tier={tierKey(g.tier.stars)} />
          </span>
          <span class="season-result" data-result={g.result}>
            {g.result}
          </span>
          <span class="season-margin">{signed(g.pf - g.pa)}</span>
        </span>
      ))
    }
  </div>
  {
    legend && (
      // Inside the strip's container, so its samples scale with the ticks they explain (1.2x / 2x).
      <p class="season-legend mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.8125rem] leading-5 text-fg-muted">
        <span>Tick height = opponent tier</span>
        <span class="flex items-center gap-x-3">
          {(
            [
              ['50', 'FEI 1-5'],
              ['30', '26-50'],
              ['10', '101+'],
            ] as const
          ).map(([k, label]) => (
            <span class="flex items-center gap-1.5">
              <span class="tier-tick-cell">
                <span class="tier-dot" data-tier={k} aria-hidden="true" />
              </span>
              {label}
            </span>
          ))}
        </span>
      </p>
    )
  }
</div>
