---
/**
 * Game log (DESIGN §14): toughest opponent first (gameRows): opponent (linked when FBS), opponent
 * tier (pips + band, from the CURRENT week's FEI ranks), site, result + margin, score, then the
 * date (last: the rows are sorted by opponent, not by date). Under 640px the site (and committee rank) folds into a second line under the
 * opponent, the date moves under the score, and the tier label is dropped (stars keep their
 * accessible name), so the table fits 328px (a 360px phone) without scrolling.
 */
import { gameRows } from '@lib/data';
import type { WeekFile } from '@lib/types';
import Stars from './Stars.astro';
import TeamChip from './TeamChip.astro';
import { SITE_LABELS, fmtShortDate, signed } from './site';

interface Props {
  week: WeekFile;
  slug: string;
  caption: string;
}
const { week, slug, caption } = Astro.props;
const rows = gameRows(week, slug);
const cfp = (o: (typeof rows)[number]['opp']): number | null => (o.fbs ? (week.teams[o.slug]?.ranks.committee ?? null) : null);
---

<div class="table-wrap">
  <table class="data-table max-sm:[&_:is(td,th)]:px-1.5 max-sm:[&_:is(td,th):first-child]:pl-0 max-sm:[&_:is(td,th):last-child]:pr-0">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Opponent</th>
        <th scope="col"><span class="max-sm:hidden">Opponent tier</span><span class="sm:hidden">Tier</span></th>
        <th scope="col" class="max-sm:hidden">Site</th>
        <th scope="col" data-num>Result</th>
        <th scope="col" data-num>Score</th>
        <th scope="col" class="max-sm:hidden">Date</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((g) => (
          <tr>
            <td>
              <span class="flex flex-col items-start">
                <span class="flex items-center gap-2">
                  <TeamChip week={week} slug={g.opp.slug} nonFbs={!g.opp.fbs} tap />
                  {cfp(g.opp) !== null && <span class="label-caps whitespace-nowrap text-fg-muted max-sm:hidden">CFP {cfp(g.opp)}</span>}
                </span>
                <span class="pl-4 text-[0.8125rem] leading-4 whitespace-nowrap text-fg-muted sm:hidden">
                  {cfp(g.opp) !== null && `CFP ${cfp(g.opp)} · `}
                  {SITE_LABELS[g.site]}
                </span>
              </span>
            </td>
            <td>
              <span class="tier-cell">
                <Stars stars={g.tier.stars} label={g.tier.label} />
                <span class="tier-band" aria-hidden="true">{g.tier.label.replace(/ team$/, '')}</span>
              </span>
            </td>
            <td class="text-fg-muted max-sm:hidden">{SITE_LABELS[g.site]}</td>
            <td data-num>
              <span class="result-chip" data-result={g.result}>
                <span>{g.result}</span>
                <span>{signed(g.margin)}</span>
              </span>
            </td>
            <td data-num>
              <span class="block">
                {g.pf}-{g.pa}
              </span>
              <time datetime={g.date} class="block font-sans text-[0.75rem] leading-4 font-normal text-fg-muted sm:hidden">
                {fmtShortDate(g.date)}
              </time>
            </td>
            <td class="whitespace-nowrap text-fg-muted max-sm:hidden">
              <time datetime={g.date}>{fmtShortDate(g.date)}</time>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
