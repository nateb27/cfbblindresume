---
/**
 * Rank delta (`.delta`, drawn triangle). `value` > 0 means `subject` ranks the team higher than
 * `ref` (up), < 0 lower (down). Default perspective: FEI's strength of record vs the committee
 * (value = committee rank − SoR rank). Equal ranks: nothing visible (DESIGN: omit when equal),
 * or a muted "=" with `same="equals"` where an empty table cell would read as missing data.
 */
import { deltaSr } from './site';

interface Props {
  value: number | null;
  subject?: string;
  ref?: string;
  same?: 'omit' | 'equals';
}
const { value, subject, ref, same = 'omit' } = Astro.props;
---

{
  value === null ? (
    <span class="text-fg-faint">
      <span aria-hidden="true">—</span>
      <span class="sr-only">No committee rank</span>
    </span>
  ) : value === 0 ? (
    same === 'equals' ? (
      <span class="cond text-[0.9375rem] font-bold text-fg-muted">
        <span aria-hidden="true">=</span>
        <span class="sr-only">{deltaSr(0, subject, ref)}</span>
      </span>
    ) : (
      <span class="sr-only">{deltaSr(0, subject, ref)}</span>
    )
  ) : (
    <span class="delta" data-dir={value > 0 ? 'up' : 'down'}>
      {Math.abs(value)}
      <span class="sr-only">{deltaSr(value, subject, ref)}</span>
    </span>
  )
}
