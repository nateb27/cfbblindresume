---
/**
 * Ad slot (SPEC "Ads", DESIGN §15). Renders nothing unless PUBLIC_ADS=on. When on: a labeled,
 * height-reserved container (CLS 0); the network loader stub in BaseLayout fills it later. A plain
 * div with a visible "Advertisement" label, not a landmark (two slots on one page must not form two
 * identically named landmarks). Pages that render one pass `ads` to BaseLayout so the loader is
 * injected only where a slot exists. Never inside cards, modals or the game's play area.
 */
import { ADS_ON } from './site';

interface Props {
  kind: 'leaderboard' | 'incontent' | 'sidebar';
  class?: string;
}
const { kind, class: cls } = Astro.props;
---

{
  ADS_ON && (
    <div class:list={['ad-slot', cls]} data-kind={kind}>
      <span class="ad-label">Advertisement</span>
      <div class="ad-box" data-ad-slot={kind} />
    </div>
  )
}
