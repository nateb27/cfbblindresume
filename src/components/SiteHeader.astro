---
/**
 * Site header: wordmark + main nav (Play, Rankings, Bubble, Teams, How it works).
 * Phones: wordmark + Play on the first row, the other four links on a second row. No JS.
 * `game`: the page is a game surface (/ and /r/*), whose own Play is the call to action.
 */
import Wordmark from './Wordmark.astro';
import type { NavKey } from './site';

interface Props {
  current?: NavKey;
  game?: boolean;
}
const { current, game = false } = Astro.props;

const items: { key: NavKey; href: string; label: string }[] = [
  { key: 'play', href: '/', label: 'Play' },
  { key: 'rankings', href: '/rankings', label: 'Rankings' },
  { key: 'bubble', href: '/bubble', label: 'Bubble' },
  { key: 'teams', href: '/teams', label: 'Teams' },
  { key: 'how', href: '/how-it-works', label: 'How it works' },
];
---

<header class="border-b border-line">
  <div class="mx-auto grid max-w-page grid-cols-[1fr_auto] items-center px-gutter sm:flex sm:h-14 sm:justify-between sm:gap-6 lg:px-gutter-lg">
    <a href="/" class="flex h-12 items-center sm:h-14" aria-label="CFB Blind Resume home">
      <Wordmark />
    </a>
    {/* Phones: Play is a violet button on content pages. On the game page itself the intro's Play is
        the one call to action and this becomes the current-page mark (an ink rule); on a shared
        result (/r/*, not the Play page) "Play it yourself" is, and this is a plain ink link. */}
    {
      current === 'play' ? (
        <a href="/#play" class="flex h-12 items-center px-2.5 text-sm font-bold text-fg shadow-[inset_0_-3px_0_var(--color-fg)] sm:hidden" aria-current="page">
          Play
        </a>
      ) : game ? (
        <a href="/#play" class="flex h-12 items-center px-2.5 text-sm font-semibold text-fg sm:hidden">
          Play
        </a>
      ) : (
        <a href="/#play" class="btn btn-primary min-h-11 px-4 text-[0.9375rem] sm:hidden">
          Play
        </a>
      )
    }
    <nav aria-label="Main" class="col-span-2 -mx-gutter overflow-x-auto border-t border-line sm:mx-0 sm:self-stretch sm:overflow-visible sm:border-0">
      <ul class="flex h-11 items-stretch justify-between px-1.5 sm:h-full sm:justify-end sm:gap-1 sm:px-0">
        {
          items.map((it) => (
            <li class:list={['flex', it.key === 'play' && 'max-sm:hidden']}>
              <a
                href={it.href}
                aria-current={current === it.key ? 'page' : undefined}
                class:list={[
                  'flex items-center px-2.5 text-sm whitespace-nowrap transition-colors hover:text-fg sm:px-3',
                  current === it.key ? 'font-bold text-fg shadow-[inset_0_-3px_0_var(--color-fg)]' : 'text-fg-muted',
                ]}
              >
                {it.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
