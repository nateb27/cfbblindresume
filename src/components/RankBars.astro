---
/**
 * The team stat row (DESIGN §14): committee rank and FEI's strength of record first (the two
 * verdicts), then FEI overall, offense, defense and schedule. Each: label, "#N", a 6px bar
 * (tier color of that rank band, filled by rankFill; the committee rank too, so a #20 committee
 * bar never looks longer than a #14 strength of record), and the FEI value. Strength of record and
 * schedule also say what the value means, in the words of /how-it-works.
 */
import type { Team, WeekFile } from '@lib/types';
import { METRICS, bandKey, feiValue, fill, fmtShortDate } from './site';

interface Props {
  team: Team;
  week: WeekFile;
  class?: string;
}
const { team: t, week, class: cls } = Astro.props;
const n = week.fbsCount;
const num = (v: number) => Math.abs(v).toFixed(2);
const gwdWords =
  Math.abs(t.values.gwd) < 0.005
    ? 'As many wins as a good team would expect on this schedule'
    : `${num(t.values.gwd)} ${t.values.gwd > 0 ? 'more' : 'fewer'} wins than a good team would expect on this schedule`;
const elsWords = `An elite team would expect ${num(t.values.els)} losses on this schedule`;
const cells = [
  { ...METRICS.sor, rank: t.ranks.sor, words: gwdWords, value: `GWD ${feiValue(t.values.gwd)}` },
  { ...METRICS.fei, rank: t.ranks.fei, words: null, value: `FEI ${feiValue(t.values.fei)}` },
  { ...METRICS.off, rank: t.ranks.off, words: null, value: `OFEI ${feiValue(t.values.ofei)}` },
  { ...METRICS.def, rank: t.ranks.def, words: null, value: `DFEI ${feiValue(t.values.dfei)}` },
  { ...METRICS.sos, rank: t.ranks.sos, words: elsWords, value: `ELS ${feiValue(t.values.els)}` },
];
const c = t.ranks.committee;
const release = week.sources.committee?.releaseDate;
---

<dl class:list={['grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-6', cls]}>
  {
    week.committee && (
      <div>
        <dt class="label-caps text-fg-muted">Committee</dt>
        <dd class="cond text-stat-lg">{c === null ? 'NR' : `#${c}`}</dd>
        {c === null ? (
          <dd class="mt-1.5 h-1.5 rounded-slab bg-track" />
        ) : (
          <dd class="meter mt-1.5" data-tier={bandKey(c)} style={`--fill:${fill(c, n)}`}>
            <span />
          </dd>
        )}
        <dd class="mt-1.5 text-[0.8125rem] leading-4 text-fg-muted">
          {c === null ? `Outside the top ${week.committee.length}` : release ? `Released ${fmtShortDate(release)}` : 'Top 25'}
        </dd>
      </div>
    )
  }
  {
    cells.map((m, i) => (
      <div class:list={[i === 0 && week.committee && 'lg:border-r lg:border-line lg:pr-6']}>
        <dt class="label-caps text-fg-muted">
          <a href={`/how-it-works#${m.anchor}`} class="hover:text-fg">
            {m.label}
          </a>
        </dt>
        <dd class="cond text-stat-lg">#{m.rank}</dd>
        <dd class="meter mt-1.5" data-tier={bandKey(m.rank)} style={`--fill:${fill(m.rank, n)}`}>
          <span />
        </dd>
        {m.words && <dd class="mt-1.5 text-[0.8125rem] leading-4 text-fg">{m.words}</dd>}
        <dd class:list={['text-[0.8125rem] leading-4 text-fg-muted', m.words ? 'mt-0.5' : 'mt-1.5']}>{m.value}</dd>
      </div>
    ))
  }
</dl>
