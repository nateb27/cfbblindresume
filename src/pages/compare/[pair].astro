---
/**
 * /compare/{a}-vs-{b}: every pair in the committee top 25 (better committee rank first). Two
 * un-blinded resume cards side by side (stacked on phones), the head-to-head note, who the
 * committee and FEI prefer, shared opponents and where each stands in every playoff format.
 * Old or reversed pair URLs are 301-redirected here by /_redirects (src/pages/[redirects].ts).
 */
import { comparePairs, gameRows, headToHead, nearestCompares, type GameRow } from '@lib/data';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlayCta from '../../components/PlayCta.astro';
import ResumeCard from '../../components/ResumeCard.astro';
import { stripCol, stripGames } from '../../components/resume-strip';
import Stars from '../../components/Stars.astro';
import TeamChip from '../../components/TeamChip.astro';
import TeamLink from '../../components/TeamLink.astro';
import UpcomingTable from '../../components/UpcomingTable.astro';
import { teamVars } from '../../styles/tokens';
import {
  ADS_ON,
  SITE_LABELS,
  absUrl,
  clampText,
  compareHref,
  compareHubHref,
  compareOgPath,
  firstFit,
  fmtShortDate,
  formatShortLabel,
  formatStatus,
  latestWeek,
  ordinal,
  outText,
  playoffViews,
  record,
  resumeHighlights,
  signed,
  sportsTeamLd,
  standingIn,
  siteVs,
  upcomingLine,
  upcomingSummary,
} from '../../components/site';

export function getStaticPaths() {
  return comparePairs(latestWeek()).map((p) => ({ params: { pair: p.slug }, props: { a: p.a, b: p.b } }));
}

const { a, b } = Astro.props as { a: string; b: string };
const week = latestWeek();
const A = week.teams[a]!;
const B = week.teams[b]!;
// Both cards' season strips on one column width and one number of slots, so the two read as one chart.
const sharedStripCol = Math.max(stripCol(week, a), stripCol(week, b));
const sharedStripSlots = Math.max(stripGames(week, a).length, stripGames(week, b).length);
const views = playoffViews(week);
const path = compareHref(`${a}-vs-${b}`);
const labelLower = week.label.replace(/^After/, 'after');

// Verdicts
const cPref = A.ranks.committee! <= B.ranks.committee! ? [A, B] : [B, A];
const fPref = A.ranks.sor <= B.ranks.sor ? [A, B] : [B, A];
const oPref = A.ranks.fei <= B.ranks.fei ? [A, B] : [B, A];
const agree = cPref[0]!.slug === fPref[0]!.slug;

// Head to head
const h2h = headToHead(week, a, b);
const siteWord = (s: 'home' | 'away' | 'neutral') => (s === 'home' ? 'at home' : s === 'away' ? 'on the road' : 'at a neutral site');

// Shared opponents (FBS and non-FBS), by toughest tier first
const rowsA = gameRows(week, a);
const rowsB = gameRows(week, b);
const key = (r: GameRow) => `${r.opp.fbs ? 'f' : 'n'}:${r.opp.slug}`;
const byOpp = (rows: GameRow[]) => {
  const m = new Map<string, GameRow[]>();
  for (const r of rows) m.set(key(r), [...(m.get(key(r)) ?? []), r]);
  return m;
};
const aByOpp = byOpp(rowsA);
const bByOpp = byOpp(rowsB);
const shared = [...aByOpp.keys()]
  .filter((k) => bByOpp.has(k) && k !== `f:${a}` && k !== `f:${b}`)
  .map((k) => ({ opp: aByOpp.get(k)![0]!.opp, tier: aByOpp.get(k)![0]!.tier, a: aByOpp.get(k)!, b: bByOpp.get(k)! }));

// Remaining schedules side by side (hidden when the week file carries none)
const upA = upcomingSummary(week, a);
const upB = upcomingSummary(week, b);
const upcoming = upA && upB ? [{ t: A, u: upA }, { t: B, u: upB }] : null;

// More compares around each team
const more = [...nearestCompares(week, a, 4), ...nearestCompares(week, b, 4)]
  .filter((p, i, arr) => p.slug !== `${a}-vs-${b}` && arr.findIndex((x) => x.slug === p.slug) === i)
  .slice(0, 6);

const title = firstFit([
  `${A.name} vs ${B.name}: Playoff Resumes Compared (${week.season})`,
  `${A.name} vs ${B.name}: Resumes Compared (${week.season})`,
  `${A.name} vs ${B.name} Playoff Resumes (${week.season})`,
]);
const verdicts = `committee #${A.ranks.committee} vs #${B.ranks.committee}; FEI strength of record ${agree ? 'agrees' : `prefers ${fPref[0]!.name}`} (#${fPref[0]!.ranks.sor} vs #${fPref[1]!.ranks.sor}).`;
const description = clampText([
  [`${A.name} (${record(A)}) vs ${B.name} (${record(B)}) ${labelLower}: ${verdicts}`, `${A.name} vs ${B.name} ${labelLower}: ${verdicts}`, `${A.name} vs ${B.name}: ${verdicts}`],
  h2h.length ? ` ${week.teams[h2h[h2h.length - 1]!.winner]!.name} won the head-to-head.` : '',
  [' Ratings, quality wins and game logs side by side.', ' Resumes side by side.'],
]);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${A.name} vs ${B.name}`,
  url: absUrl(path),
  numberOfItems: 2,
  itemListElement: [A, B].map((t, i) => ({ '@type': 'ListItem', position: i + 1, item: sportsTeamLd(t) })),
};
const orders = [
  ...(views.committee ? [{ key: 'committee' as const, title: 'By the committee', res: views.committee }] : []),
  { key: 'fei' as const, title: 'By strength of record', res: views.fei },
];
const standingShort = (p: (typeof orders)[number]['res'][string], slug: string) => {
  const st = standingIn(p, slug);
  return st.kind === 'in' ? `In · ${ordinal(st.seed!.seed)} seed${st.bye ? ', bye' : ''}` : st.kind === 'first-out' ? outText(st.outPos!) : 'Out';
};
// Phones: every rank side by side ahead of the stacked cards (better value in ink 800, the other in
// carbon 600, as on the compare OG image), so comparing offense or schedule needs no scrolling.
const hlA = resumeHighlights(week, a);
const hlB = resumeHighlights(week, b);
const pct = (wl: { w: number; l: number } | null) => (wl && wl.w + wl.l > 0 ? wl.w / (wl.w + wl.l) : null);
// The row header names the rank ("Schedule" adds "#1 = hardest"); the caption says #1 is best.
const rankRows: { k: string; av: string; bv: string; better: 'a' | 'b' | null }[] = [
  ...(A.ranks.committee !== null && B.ranks.committee !== null ? [{ k: 'Committee', a: A.ranks.committee, b: B.ranks.committee }] : []),
  { k: 'Strength of record', a: A.ranks.sor, b: B.ranks.sor },
  { k: 'FEI overall', a: A.ranks.fei, b: B.ranks.fei },
  { k: 'Offense', a: A.ranks.off, b: B.ranks.off },
  { k: 'Defense', a: A.ranks.def, b: B.ranks.def },
  { k: 'Schedule', a: A.ranks.sos, b: B.ranks.sos },
].map((r) => ({ k: r.k, av: `#${r.a}`, bv: `#${r.b}`, better: r.a === r.b ? null : r.a < r.b ? 'a' : 'b' }));
if (hlA.vsCommittee && hlB.vsCommittee) {
  const pa = pct(hlA.vsCommittee);
  const pb = pct(hlB.vsCommittee);
  rankRows.push({
    k: `vs CFP top ${hlA.vsCommittee.n}`,
    av: `${hlA.vsCommittee.w}-${hlA.vsCommittee.l}`,
    bv: `${hlB.vsCommittee.w}-${hlB.vsCommittee.l}`,
    better: pa === null || pb === null || pa === pb ? null : pa > pb ? 'a' : 'b',
  });
}

// The pitch: the lower committee team's case (or the strength-of-record pick when they disagree).
const underdog = agree ? cPref[1]! : fPref[0]!;
const overdog = underdog.slug === A.slug ? B : A;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ads
  ogImage={compareOgPath(`${a}-vs-${b}`)}
  ogImageAlt={`${A.name} vs ${B.name}: committee #${A.ranks.committee} vs #${B.ranks.committee}, FEI strength of record #${A.ranks.sor} vs #${B.ranks.sor}`}
  jsonLd={ld}
  current="rankings"
  week={week}
>
  <div class="mx-auto max-w-page px-gutter lg:px-gutter-lg">
    <Breadcrumbs
      items={[
        { name: 'Rankings', href: '/rankings' },
        { name: `${A.name} vs ${B.name}`, href: path },
      ]}
    />
    <h1 class="cond mt-2 text-title lg:text-display">
      {A.name} vs {B.name}
    </h1>
    <p class="mt-2 text-sm text-fg-muted">Playoff resumes compared · {week.label}, {week.season}</p>

    <div class="mt-6 flex flex-col gap-1.5">
      {
        h2h.length ? (
          h2h.map((g) => (
            <p class="inline-flex w-fit flex-wrap items-center gap-2.5 rounded-chip border border-line-strong bg-surface py-1.5 pr-3 pl-2">
              <span class="rounded-slab bg-fg px-1.5 py-0.5 text-[0.75rem] leading-4 font-extrabold text-page">H2H</span>
              <span class="cond text-[1.0625rem] font-semibold">
                <TeamLink team={week.teams[g.winner]!} /> beat <TeamLink team={week.teams[g.loser]!} />{' '}
                {`${g.winnerPoints}-${g.loserPoints} ${siteWord(g.winnerSite)} · ${fmtShortDate(g.date)}`}
              </span>
            </p>
          ))
        ) : (
          <p class="inline-flex w-fit items-center gap-2.5 rounded-chip border border-line-strong bg-surface py-1.5 pr-3 pl-2">
            <span class="rounded-slab bg-fg px-1.5 py-0.5 text-[0.75rem] leading-4 font-extrabold text-page">H2H</span>
            <span class="cond text-[1.0625rem] font-semibold">No meeting this season</span>
          </p>
        )
      }
    </div>

    {/* Who prefers whom: one ruled list, a 44px row per source; the verdict is its caption. Below
        48rem (stacked cards) it becomes a two-column table of every rank instead. */}
    <section class="mt-5 max-w-[40rem]" aria-labelledby="prefers">
      <h2 id="prefers" class="label-caps text-fg-muted">
        {agree ? 'The committee and strength of record agree' : 'The committee and strength of record disagree'}
      </h2>
      <div class="table-wrap mt-1.5 md:hidden">
        <table class="data-table" data-testid="compare-ranks">
          <caption class="sr-only">{`${A.name} and ${B.name}: every rank side by side (#1 is best of ${week.fbsCount} FBS teams; schedule #1 is the hardest)`}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Rank</span></th>
              <th scope="col" data-num><TeamChip week={week} slug={a} label={A.short} /></th>
              <th scope="col" data-num><TeamChip week={week} slug={b} label={B.short} /></th>
            </tr>
          </thead>
          <tbody>
            {
              rankRows.map((r) => (
                <tr>
                  <th scope="row" class="!text-left text-[0.875rem] font-semibold text-fg-muted">
                    {r.k}
                    {r.k === 'Schedule' && <span class="block text-[0.75rem] leading-4 font-normal">#1 = hardest</span>}
                  </th>
                  {(['a', 'b'] as const).map((side) => (
                    <td data-num class:list={['cond text-[1.0625rem]', r.better === side ? 'font-extrabold text-fg' : 'font-semibold text-fg-muted']}>
                      {side === 'a' ? r.av : r.bv}
                      {r.better === side && <span class="sr-only"> (better)</span>}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <dl class="mt-1.5 divide-y divide-line rounded-card border border-line-strong bg-surface max-md:hidden">
        {
          [
            { k: 'Committee', short: 'Committee', w: cPref, r: (t: typeof A) => `#${t.ranks.committee}` },
            { k: 'FEI strength of record', short: 'FEI SoR', w: fPref, r: (t: typeof A) => `#${t.ranks.sor}` },
            { k: 'FEI overall', short: 'FEI overall', w: oPref, r: (t: typeof A) => `#${t.ranks.fei}` },
          ].map((v) => (
            <div class="grid min-h-11 grid-cols-[4.75rem_minmax(0,1fr)] items-center gap-x-3 px-3 py-1.5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:px-4">
              <dt class="label-caps text-fg-muted">
                <span class="sm:hidden">{v.short}</span>
                <span class="max-sm:hidden">{v.k}</span>
                <span class="sr-only"> prefers</span>
              </dt>
              <dd class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                <TeamChip week={week} slug={v.w[0]!.slug} />
                <b class="cond text-[1.125rem] leading-6">{v.r(v.w[0]!)}</b>
                <span class="text-sm text-fg-muted">
                  over <TeamLink team={v.w[1]!} class="text-fg-muted" /> <span class="cond font-semibold">{v.r(v.w[1]!)}</span>
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="mt-8 grid items-start gap-5 md:grid-cols-2">
      <ResumeCard week={week} slug={a} stripCol={sharedStripCol} stripSlots={sharedStripSlots} />
      <ResumeCard week={week} slug={b} stripCol={sharedStripCol} stripSlots={sharedStripSlots} />
    </div>
    <p class="mt-3 text-[0.8125rem] text-fg-muted">
      #N = rank among all {week.fbsCount} FBS teams (schedule: #1 = hardest). Opponent tiers use this week's FEI ranks. Ratings:{' '}
      <a class="link" href={week.sources.ratings.url}>FEI by {week.sources.ratings.author}</a>
    </p>

    <PlayCta
      class="mt-8"
      record={record(underdog)}
      heading={`Think ${underdog.name} belongs above ${overdog.name}?`}
      body="Rank resumes like these with the names hidden. Your picks build your own top 25 and bracket, next to the committee's."
    />

    <AdSlot kind="incontent" class="mt-10" />

    <div class:list={['mt-12 grid gap-12', ADS_ON && 'lg:grid-cols-[minmax(0,1fr)_300px]']}>
      <div class="flex min-w-0 flex-col gap-12">
        <div class="grid gap-12 lg:grid-cols-2">
        <section aria-labelledby="shared" class="min-w-0 lg:order-2">
          <h2 id="shared" class="cond text-heading">Shared opponents</h2>
          {
            shared.length === 0 ? (
              <p class="mt-2 text-fg-muted">
                <TeamLink team={A} class="text-fg-muted" /> and <TeamLink team={B} class="text-fg-muted" /> have no common opponents this season.
              </p>
            ) : (
              <div class="table-wrap mt-3">
                <table class="data-table">
                  <caption class="sr-only">
                    Results against common opponents
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Opponent</th>
                      <th scope="col">Tier</th>
                      <th scope="col" data-num>
                        <TeamChip week={week} slug={a} label={A.short} />
                      </th>
                      <th scope="col" data-num>
                        <TeamChip week={week} slug={b} label={B.short} />
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {shared.map((s) => (
                      <tr>
                        <td>
                          <TeamChip week={week} slug={s.opp.slug} nonFbs={!s.opp.fbs} tap class="sm:whitespace-nowrap" />
                        </td>
                        <td>
                          {/* Pips + band text on every row (phones: the short band under the pips), as in the game log. */}
                          <span class="tier-cell">
                            <Stars stars={s.tier.stars} label={s.tier.label} />
                            <span class="tier-band" aria-hidden="true">{s.tier.label.replace(/ team$/, '')}</span>
                          </span>
                        </td>
                        {[s.a, s.b].map((games, i) => (
                          <td data-num>
                            <span class="inline-flex flex-col items-end gap-1">
                              {games.map((g) => (
                                <span class="inline-flex items-center gap-2">
                                  <span class="text-[0.8125rem] font-normal text-fg-muted max-sm:hidden">{SITE_LABELS[g.site]}</span>
                                  <span class="result-chip" data-result={g.result}>
                                    <span>{g.result}</span>
                                    <span>{signed(g.margin)}</span>
                                  </span>
                                  <span class="sr-only">{`${[A, B][i]!.name} ${g.result === 'W' ? 'won' : 'lost'} ${g.pf}-${g.pa}`}</span>
                                </span>
                              ))}
                            </span>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }
        </section>

        <section aria-labelledby="fields" class="min-w-0 lg:order-1">
          <h2 id="fields" class="cond text-heading">In the projected fields</h2>
          <div class="table-wrap mt-3">
            <table class="data-table">
              <caption class="sr-only">Where each team stands in every projected playoff field</caption>
              <thead>
                <tr>
                  <th scope="col">Field</th>
                  <th scope="col">
                    <TeamChip week={week} slug={a} label={A.short} />
                  </th>
                  <th scope="col">
                    <TeamChip week={week} slug={b} label={B.short} />
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  views.formats.flatMap((f) =>
                    orders.map((o) => (
                      <tr>
                        <th scope="row" class="!border-b-line !align-middle font-sans text-sm font-normal text-fg">
                          {formatShortLabel(f, week.season)}
                          <span class="block text-[0.8125rem] text-fg-muted">{o.title}</span>
                        </th>
                        {[a, b].map((s) => (
                          <td class="cond text-[1.0625rem] font-semibold">{standingShort(o.res[f.id]!, s)}</td>
                        ))}
                      </tr>
                    )),
                  )
                }
              </tbody>
            </table>
          </div>
          {
            views.formats
              .filter((f) => f.status === 'proposed')
              .map((f) => (
                <p class="mt-2 text-[0.8125rem] text-fg-muted">
                  {`${f.label}: ${formatStatus(f, week.season)}. `}
                  <a class="link" href={f.sourceUrl}>
                    Source: {f.sourceName}
                  </a>
                </p>
              ))
          }
        </section>
        </div>

        {
          upcoming && (
            <section aria-labelledby="remaining">
              <h2 id="remaining" class="cond text-heading">
                Remaining schedule
              </h2>
              <p class="mt-1 text-sm text-fg-muted">Regular season, in date order. Tiers and CFP ranks are this week's.</p>
              <div class="mt-4 grid gap-8 md:grid-cols-2">
                {upcoming.map(({ t, u }) => (
                  <div class="min-w-0">
                    <h3 class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <TeamChip week={week} slug={t.slug} />
                    </h3>
                    <p class="mt-1 text-[0.8125rem] leading-5 text-fg-muted">
                      {upcomingLine(week, u)}
                      {u.toughest && (
                        <>
                          {' · toughest: '}
                          <span class="text-fg">{siteVs(u.toughest.site, u.toughest.opp.name)}</span>
                        </>
                      )}
                    </p>
                    <UpcomingTable week={week} slug={t.slug} caption={`${t.name} remaining schedule, in date order`} compact class="mt-2" />
                  </div>
                ))}
              </div>
              <p class="mt-2 text-[0.8125rem] text-fg-muted">Conf = conference game.</p>
            </section>
          )
        }

        {
          more.length > 0 && (
            <section aria-labelledby="more">
              <h2 id="more" class="cond text-heading">
                More comparisons
              </h2>
              <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                {more.map((p) => {
                  const x = week.teams[p.a]!;
                  const y = week.teams[p.b]!;
                  return (
                    <li>
                      <a href={compareHref(p.slug)} class="flex min-h-12 flex-wrap items-center gap-x-2 gap-y-1 rounded-chip border border-line-strong px-3 py-2 transition-colors hover:border-control hover:bg-surface">
                        <span class="team-chip" style={teamVars(x.colors)}>
                          {x.name}
                        </span>
                        <span class="text-sm text-fg-muted">vs</span>
                        <span class="team-chip" style={teamVars(y.colors)}>
                          {y.name}
                        </span>
                        <span class="cond ml-auto text-[0.9375rem] font-semibold text-fg-muted">
                          #{p.aRank} vs #{p.bRank}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
              <p class="mt-3 text-sm text-fg-muted">
                <a class="link text-fg" href={compareHubHref}>
                  Every committee matchup
                </a>{' '}
                · all {comparePairs(week).length} pairs in the committee's top {week.committee?.length}.
              </p>
            </section>
          )
        }
      </div>
      {
        ADS_ON && (
          <div>
            <AdSlot kind="sidebar" />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
