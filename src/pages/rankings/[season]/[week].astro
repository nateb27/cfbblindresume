---
/** /rankings/{season}/week-{N}: a frozen copy of the rankings page for every week file; canonical to itself. */
import { committeeOrder, gwdOrder, TOP_N } from '@lib/data';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RankingsView from '../../../components/RankingsView.astro';
import { allWeekRefs, archiveHref, getWeek, itemListLd, teamHref } from '../../../components/site';

export function getStaticPaths() {
  return allWeekRefs().map((r) => ({ params: { season: String(r.season), week: `week-${r.week}` }, props: { season: r.season, week: r.week } }));
}

const { season, week: wk } = Astro.props as { season: number; week: number };
const week = getWeek(season, wk);
const c = committeeOrder(week);
const fei = gwdOrder(week);
const n = c?.length ?? TOP_N;
const top = (o: string[], k: number) => o.slice(0, k).map((s) => week.teams[s]!.name);
const title = c
  ? `College Football Playoff Rankings vs FEI, ${week.label} ${season} (Weekly Archive)`
  : `FEI Strength of Record Top ${n}, ${week.label} ${season} (Weekly Archive)`;
const description = c
  ? `Archived ${week.label} ${season} rankings: the committee's top ${n} (${top(c, 3).join(', ')} on top) beside FEI's strength of record (${top(fei, 3).join(', ')}), with projected playoff fields as they stood that week.`
  : `Archived ${week.label} ${season}: FEI's strength of record top ${n} (${top(fei, 3).join(', ')}) and the projected playoff fields as they stood that week.`;
const ld = itemListLd(
  c ? `Committee top ${n}, ${week.label} ${season}` : `FEI strength of record top ${n}, ${week.label} ${season}`,
  (c ?? fei.slice(0, n)).map((s) => ({ name: week.teams[s]!.name, path: teamHref(s) })),
);
---

<BaseLayout title={title} description={description} path={archiveHref(season, wk)} jsonLd={ld} current="rankings" week={week}>
  <RankingsView week={week} archive={true} />
</BaseLayout>
