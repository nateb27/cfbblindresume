---
/**
 * /bubble: the committee's 8-20 re-sorted by FEI strength of record with the gap drawn, then who is
 * in or out of every playoff format by the committee vs by strength of record, who changes sides
 * and why, and the compare pages for the matchups on each cut line.
 */
import { bubble, committeeOrder, gwdOrder } from '@lib/data';
import type { PlayoffFormat } from '@lib/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CutPairs from '../components/CutPairs.astro';
import Delta from '../components/Delta.astro';
import PlayCta from '../components/PlayCta.astro';
import TeamChip from '../components/TeamChip.astro';
import TeamLink from '../components/TeamLink.astro';
import {
  ADS_ON,
  SOR,
  autoBidPhrase,
  clampText,
  cutStory,
  formatKicker,
  formatSizeLabel,
  formatsPhrase,
  itemListLd,
  joinAnd,
  latestWeek,
  ordinal,
  outText,
  playoffViews,
  rankIn,
  record,
  standingIn,
  teamHref,
  type FieldStanding,
} from '../components/site';

const week = latestWeek();
const views = playoffViews(week);
const FROM = 8;
const TO = 20;
const rows = bubble(week, { from: FROM, to: TO });
const committee = committeeOrder(week);
const labelLower = week.label.replace(/^After/, 'after');

// Dumbbell scale: rank 1 .. the largest rank shown (at least the committee's length), in % of the
// chart column so the chart fills whatever width the column gets.
const maxRank = Math.max(committee?.length ?? 25, ...rows.flatMap((r) => [r.gwd, r.committee ?? 0]));
const pct = (rank: number) => `${(((rank - 1) / (maxRank - 1)) * 100).toFixed(2)}%`;
const ticks = [1, 5, 10, 15, 20, 25, 30, 35, 40].filter((t) => t <= maxRank);
const biggest = rows.reduce((m, r) => Math.max(m, Math.abs(r.delta ?? 0)), 0);

// In/out matrix: bubble teams + every team whose status differs between the two orders + first five out.
type OrderKey = 'committee' | 'fei';
const orders: readonly OrderKey[] = views.committee ? ['committee', 'fei'] : ['fei'];
const res = (o: OrderKey, f: PlayoffFormat) => (o === 'committee' ? views.committee![f.id]! : views.fei[f.id]!);
const status = (o: OrderKey, f: PlayoffFormat, slug: string): FieldStanding => standingIn(res(o, f), slug);
const inField = (o: OrderKey, f: PlayoffFormat, slug: string) => status(o, f, slug).kind === 'in';
const matrixSet = new Set<string>(rows.map((r) => r.slug));
const changes = views.formats.map((f) => {
  const a = new Set(views.committee ? res('committee', f).field.map((s) => s.slug) : []);
  const b = new Set(res('fei', f).field.map((s) => s.slug));
  const cmteOnly = views.committee ? [...a].filter((s) => !b.has(s)) : [];
  const feiOnly = views.committee ? [...b].filter((s) => !a.has(s)) : [];
  for (const s of [...cmteOnly, ...feiOnly]) matrixSet.add(s);
  for (const o of orders) for (const s of res(o, f).firstFiveOut) matrixSet.add(s);
  const stories = orders.map((o) => ({ o, ...cutStory(res(o, f)) })).filter((x) => x.out.length > 0 && x.by.length > 0);
  return { f, cmteOnly, feiOnly, stories };
});
const gwd = gwdOrder(week);
const matrix = [...matrixSet].sort((x, y) => gwd.indexOf(x) - gwd.indexOf(y));
const cell = (st: FieldStanding): { short: string; long: string; inField: boolean } =>
  st.kind === 'in'
    ? { short: `In ${st.seed!.seed}`, long: `In, ${ordinal(st.seed!.seed)} seed`, inField: true }
    : st.kind === 'first-out'
      ? { short: outText(st.outPos!), long: `${ordinal(st.outPos!)} team out`, inField: false }
      : { short: 'Out', long: 'Out', inField: false };
const orderHead = (o: OrderKey) => (o === 'committee' ? 'CFP' : SOR);

const title = committee
  ? `CFP Bubble Watch ${week.label}, ${week.season}: Who's In, Who's Out`
  : `CFP Bubble Watch ${week.label}, ${week.season}: FEI Strength of Record`;
const first = changes[0];
const movers = first ? [...first.cmteOnly, ...first.feiOnly].map((s) => week.teams[s]!.name) : [];
const description = committee
  ? clampText([
      `Who is in the playoff ${labelLower}? The committee's ${FROM}-${TO} re-sorted by FEI strength of record`,
      movers.length && first ? `; ${joinAnd(movers)} change sides in the ${formatSizeLabel(first.f)} field.` : '.',
      ` With ${formatsPhrase(views.formats)} fields by each ranking.`,
    ])
  : clampText([`The playoff bubble by FEI strength of record ${labelLower}, before the committee's first ranking.`]);
const ld = itemListLd(
  `Committee ${FROM}-${TO} sorted by FEI strength of record, ${week.label} ${week.season}`,
  rows.map((r) => ({ name: week.teams[r.slug]!.name, path: teamHref(r.slug) })),
);
---

<BaseLayout title={title} description={description} path="/bubble" jsonLd={ld} ads current="bubble" week={week}>
  <div class="mx-auto max-w-page px-gutter lg:px-gutter-lg">
    <Breadcrumbs items={[{ name: 'Bubble', href: '/bubble' }]} />
    <h1 class="cond mt-2 text-title uppercase lg:text-display">
      Bubble watch{' '}
      <span class="block text-fg-muted">{committee ? `Committee ${FROM}-${TO}, by strength of record` : week.label}</span>
    </h1>
    <p class="mt-4 max-w-read text-lg leading-7">
      {
        committee
          ? `The committee's ${FROM} through ${TO} is where playoff spots are won and lost. Here those teams are re-sorted by FEI's strength of record, with the gap between the two drawn out, and the field each ranking would produce.`
          : `The committee has not released its first ranking yet. Until it does, this page shows the field FEI's strength of record would produce.`
      }
    </p>

    {
      committee && (
        <div class:list={['mt-10', ADS_ON && 'lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-12']}>
          <section aria-labelledby="sorted" class="min-w-0">
            <h2 id="sorted" class="cond text-heading uppercase">
              Committee {FROM}-{TO}, sorted by strength of record
            </h2>
            <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-fg-muted">
              <span>{SOR} = FEI strength of record rank. Gap = committee rank vs {SOR}.</span>
              <span class="flex items-center gap-1.5 max-md:hidden">
                <svg width="12" height="12" aria-hidden="true">
                  <circle cx="6" cy="6" r="4.5" class="fill-page stroke-fg-muted" stroke-width="1.5" />
                </svg>
                Committee
              </span>
              <span class="flex items-center gap-1.5 max-md:hidden">
                <svg width="12" height="12" aria-hidden="true">
                  <circle cx="6" cy="6" r="5" class="fill-fg" />
                </svg>
                {SOR}
              </span>
            </p>
            <div class="table-wrap mt-3">
              <table class="data-table">
                <caption class="sr-only">
                  Committee {FROM} to {TO} sorted by FEI strength of record, with the gap between the two ranks
                </caption>
                <thead>
                  <tr>
                    <th scope="col" class="w-10">
                      <abbr title="FEI strength of record rank" class="no-underline">
                        {SOR}
                      </abbr>
                    </th>
                    <th scope="col">Team</th>
                    <th scope="col" data-num class="max-sm:hidden">
                      Record
                    </th>
                    <th scope="col" data-num>
                      CFP
                    </th>
                    <th scope="col" data-num>
                      Gap
                    </th>
                    <th scope="col" class="w-full min-w-48 max-md:hidden">
                      <span class="sr-only">Gap chart</span>
                      <span aria-hidden="true" class="relative mx-2 block h-4">
                        {ticks.map((t) => (
                          <span class="absolute top-0 -translate-x-1/2 text-[0.75rem] leading-4" style={`left:${pct(t)}`}>
                            {t}
                          </span>
                        ))}
                      </span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => {
                    const big = biggest > 0 && Math.abs(r.delta ?? 0) >= Math.max(4, biggest - 2);
                    const x1 = pct(r.committee!);
                    const x2 = pct(r.gwd);
                    return (
                      <tr class:list={[big && 'bg-surface']}>
                        <td class="cond text-[1.125rem] font-bold">{r.gwd}</td>
                        <td class="md:whitespace-nowrap">
                          <span class="flex flex-col items-start">
                            <TeamChip week={week} slug={r.slug} tap />
                            {big && <span class="label-caps pl-5 text-fg-muted">Big gap</span>}
                          </span>
                        </td>
                        <td data-num class="max-sm:hidden">
                          {record(week.teams[r.slug]!)}
                        </td>
                        <td data-num>{r.committee}</td>
                        <td data-num>
                          <Delta value={r.delta} same="equals" />
                        </td>
                        <td class="max-md:hidden">
                          <div class="px-2">
                            <svg width="100%" height="20" aria-hidden="true" overflow="visible" class="block">
                              <line x1="0" x2="100%" y1="10" y2="10" class="stroke-line" stroke-width="1" />
                              <line
                                x1={x1}
                                x2={x2}
                                y1="10"
                                y2="10"
                                class={r.delta! > 0 ? 'stroke-win' : r.delta! < 0 ? 'stroke-loss' : 'stroke-fg-muted'}
                                stroke-width="3"
                              />
                              <circle cx={x1} cy="10" r="5" class="fill-page stroke-fg-muted" stroke-width="2" />
                              <circle cx={x2} cy="10" r="5.5" class="fill-fg" />
                            </svg>
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-[0.8125rem] text-fg-muted">
              Gap up: strength of record ranks the team higher than the committee does. Down: lower. Highlighted rows are the biggest gaps in this
              range.
            </p>
          </section>
          {ADS_ON && (
            <div class="mt-10 lg:mt-0">
              <AdSlot kind="sidebar" />
            </div>
          )}
        </div>
      )
    }

    <AdSlot kind="incontent" class="mt-10" />

    <section aria-labelledby="inout" class="mt-12">
      <h2 id="inout" class="cond text-heading uppercase">In or out</h2>
      <p class="mt-1 max-w-read text-sm text-fg-muted">
        Every bubble team, plus anyone who changes sides between the two rankings or sits among the first five out, sorted by strength of record.
        CFP = by the committee's ranking, {SOR} = by FEI's strength of record. "In 10" = in the field as the 10th seed; "2nd out" = second team out.
      </p>
      <div class="table-wrap mt-3">
        <table class="data-table">
          <caption class="sr-only">Projected playoff status by format, by the committee and by FEI strength of record</caption>
          <thead>
            <tr>
              <th scope="col" rowspan="2" class="!align-bottom">Team</th>
              {
                views.formats.map((f) => (
                  <th scope="colgroup" colspan={orders.length} class="!border-b-0 !pb-0 text-center !text-fg">
                    {formatSizeLabel(f)}
                    {f.status === 'proposed' && (
                      <span class="block !normal-case !tracking-normal font-sans text-[0.6875rem] leading-3 font-normal text-fg-muted">proposed</span>
                    )}
                  </th>
                ))
              }
            </tr>
            <tr>
              {views.formats.map(() => orders.map((o) => <th scope="col" class="text-center max-sm:!px-1">{orderHead(o)}</th>))}
            </tr>
          </thead>
          <tbody>
            {
              matrix.map((slug) => (
                <tr>
                  <td>
                    <TeamChip week={week} slug={slug} tap />
                  </td>
                  {views.formats.map((f) => {
                    const differs = orders.length === 2 && inField('committee', f, slug) !== inField('fei', f, slug);
                    return orders.map((o) => {
                      const cl = cell(status(o, f, slug));
                      return (
                        <td class:list={['text-center whitespace-nowrap max-sm:!px-1', differs && 'bg-surface']}>
                          <span
                            class:list={['cond text-[0.875rem] font-bold sm:text-[1rem]', !cl.inField && 'text-fg-muted', differs && cl.inField && 'text-fg']}
                            aria-hidden="true"
                          >
                            {cl.short}
                          </span>
                          <span class="sr-only">{cl.long}</span>
                        </td>
                      );
                    });
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-[0.8125rem] text-fg-muted">Shaded cells: the committee and strength of record disagree on whether the team is in.</p>
    </section>

    {
      views.committee && (
        <section aria-labelledby="sides" class="mt-12">
          <h2 id="sides" class="cond text-heading uppercase">
            Who changes sides
          </h2>
          <div class="mt-4 grid gap-8 md:grid-cols-2">
            {changes.map(({ f, cmteOnly, feiOnly, stories }) => (
              <div class="callout min-w-0">
                <h3 class="label-caps text-fg">{formatKicker(f, week.season)}</h3>
                {cmteOnly.length + feiOnly.length === 0 ? (
                  <p class="mt-2">Both rankings produce the same {f.size} teams.</p>
                ) : (
                  <dl class="mt-2 flex flex-col gap-3">
                    <div>
                      <dt class="text-sm text-fg-muted">In by the committee, out by strength of record</dt>
                      <dd class="mt-1 flex flex-wrap gap-x-4 gap-y-1.5">
                        {cmteOnly.length ? cmteOnly.map((s) => <TeamChip week={week} slug={s} />) : <span class="text-fg-muted">Nobody</span>}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-sm text-fg-muted">In by strength of record, out by the committee</dt>
                      <dd class="mt-1 flex flex-wrap gap-x-4 gap-y-1.5">
                        {feiOnly.length ? feiOnly.map((s) => <TeamChip week={week} slug={s} />) : <span class="text-fg-muted">Nobody</span>}
                      </dd>
                    </div>
                  </dl>
                )}
                {stories.map((st) => {
                  const p = res(st.o, f);
                  return (
                    <p class="mt-3 text-sm leading-6">
                      <span class="text-fg-muted">{st.o === 'committee' ? "By the committee's ranking: " : 'By strength of record: '}</span>
                      {st.out.map((s, i) => (
                        <>
                          {i > 0 && (i === st.out.length - 1 ? ' and ' : ', ')}
                          <TeamLink team={week.teams[s]!} /> ({rankIn(st.o, week.teams[s]!)})
                        </>
                      ))}
                      {st.out.length > 1 ? ' are' : ' is'} out of the top {f.size} because{' '}
                      {st.by.map((b, i) => (
                        <>
                          {i > 0 && (i === st.by.length - 1 ? ' and ' : ', ')}
                          <TeamLink team={week.teams[b.slug]!} /> ({rankIn(st.o, week.teams[b.slug]!)})
                        </>
                      ))}{' '}
                      {autoBidPhrase(st.by, p, week)}.
                    </p>
                  );
                })}
                <p class="mt-3 text-[0.8125rem] text-fg-muted">
                  {f.note}{' '}
                  <a class="link" href={f.sourceUrl}>
                    Source: {f.sourceName}
                  </a>
                </p>
              </div>
            ))}
          </div>
          <p class="mt-4 text-sm text-fg-muted">
            Seeds, byes and first-round games for every field are on the <a class="link text-fg" href="/rankings">rankings page</a>.
          </p>
        </section>
      )
    }

    {committee && <CutPairs week={week} class="mt-12" />}

    <PlayCta
      class="mt-12"
      heading="Who really belongs in?"
      body={`The bubble is where the arguments are. Rank these resumes yourself with the names hidden, and see your own ${views.formats[0]!.size}-team field next to the committee's.`}
    />
  </div>
</BaseLayout>
