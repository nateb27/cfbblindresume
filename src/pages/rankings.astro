---
/** /rankings: the latest week's committee top 25 beside FEI's strength of record, with cut lines and projected fields. */
import { committeeOrder, gwdOrder, TOP_N } from '@lib/data';
import BaseLayout from '../layouts/BaseLayout.astro';
import RankingsView from '../components/RankingsView.astro';
import { RANKINGS_OG, SITE, clampText, formatsPhrase, itemListLd, latestWeek, playoffViews, teamHref } from '../components/site';

const week = latestWeek();
const views = playoffViews(week);
const c = committeeOrder(week);
const fei = gwdOrder(week);
const n = c?.length ?? TOP_N;
const top = (o: string[], k: number) => o.slice(0, k).map((s) => week.teams[s]!.name);
const when = week.label.replace(/^After/, 'after');
const title = c ? `CFP Top ${n} vs FEI Strength of Record — ${week.label}, ${week.season}` : `FEI Strength of Record Top ${n} — ${week.label}, ${week.season}`;
const description = c
  ? clampText([
      [
        `The committee's top ${n} ${when} beside FEI strength of record: ${top(c, 3).join(', ')} lead the committee; strength of record has ${top(fei, 3).join(', ')}.`,
        `The committee's top ${n} ${when} beside FEI strength of record: ${top(c, 3).join(', ')} lead one, ${top(fei, 3).join(', ')} the other.`,
        `The committee's top ${n} ${when} beside FEI strength of record, led by ${top(c, 1)[0]} and ${top(fei, 1)[0]}.`,
      ],
      [` Cut lines and ${formatsPhrase(views.formats)} fields.`, ' Cut lines and projected fields.'],
    ])
  : clampText([`FEI strength of record top ${n} ${when}, led by ${top(fei, 3).join(', ')}.`, ` Projected ${formatsPhrase(views.formats)} fields.`]);
const ld = itemListLd(
  c ? `Committee top ${n}, ${week.label} ${week.season}` : `FEI strength of record top ${n}, ${week.label} ${week.season}`,
  (c ?? fei.slice(0, n)).map((s) => ({ name: week.teams[s]!.name, path: teamHref(s) })),
);
---

<BaseLayout title={title} description={description} path="/rankings" ogImage={RANKINGS_OG} ogImageAlt={`${SITE.name}: the committee's top 5 beside FEI's strength of record top 5, ${week.label}`} jsonLd={ld} ads current="rankings" week={week}>
  <RankingsView week={week} archive={false} />
</BaseLayout>
