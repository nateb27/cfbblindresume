---
/**
 * Every page's shell: <head> SEO (unique title + description, canonical without a trailing slash,
 * Open Graph + Twitter, JSON-LD), font preload, theme, site header and footer.
 *
 * Themes: every page follows prefers-color-scheme (light = paper, dark = photostat negative).
 * Game pages (`game`) add <html data-surface="board">: white sheets on a grey board in light mode.
 * No client JavaScript is emitted here (the ad loader stub only when PUBLIC_ADS=on,
 * PUBLIC_AD_NETWORK is set and the page renders an ad slot: `ads`).
 *
 * All three Archivo files are preloaded (400 body, 600 labels and table heads, 800 numerals,
 * names and headings): a late swap of any of them would re-measure auto-width table columns.
 * The ?url imports resolve to the same fingerprinted files as the url() in global.css.
 * Share-image URLs carry the snapshot (`?v=2026-9`) so social caches refresh every week.
 */
import '../styles/global.css';
import archivo400 from '../assets/fonts/archivo-latin-400-normal.woff2?url';
import archivo600 from '../assets/fonts/archivo-latin-600-normal.woff2?url';
import archivo800 from '../assets/fonts/archivo-latin-800-normal.woff2?url';
import type { WeekFile } from '@lib/types';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { ADS_ON, AD_NETWORK, DEFAULT_OG, SITE, absUrl, latestWeek, ogVersion, type NavKey } from '../components/site';

interface Props {
  /** Full <title>, unique per page. */
  title: string;
  /** Meta description, unique per page. */
  description: string;
  /** Site path of this page ("/teams/miami"); canonical = absolute, no trailing slash. */
  path: string;
  /** Site path of the OG image (1200x630 PNG). */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** JSON-LD object(s). */
  jsonLd?: unknown;
  /** Game page (/ and /r): the board surface (white sheets on a grey board in light mode). */
  game?: boolean;
  noindex?: boolean;
  /** The page renders at least one AdSlot (the ad loader is injected only then). */
  ads?: boolean;
  /** Highlighted nav item. */
  current?: NavKey;
  /** Week the page shows (footer "as of"); defaults to the latest week. */
  week?: WeekFile;
}

const {
  title,
  description,
  path,
  ogImage = DEFAULT_OG,
  ogImageAlt = `${SITE.name}: Rank the resumes. Names hidden. Three college football resumes with the team names blacked out.`,
  ogType = 'website',
  jsonLd,
  game = false,
  noindex = false,
  ads = false,
  current,
  week = latestWeek(),
} = Astro.props;

const canonical = absUrl(path);
// A noindex content page (the 404) names no canonical; the /r shell keeps one because the /r
// Function rewrites it per share code.
const withCanonical = !noindex || game;
const image = `${absUrl(ogImage)}?${ogVersion(week)}`;
const ldItems = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const adNetwork = ads ? AD_NETWORK : undefined;
---

<!doctype html>
<html lang="en" data-surface={game ? 'board' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    {[archivo400, archivo600, archivo800].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={game ? '#e8e8e3' : '#fdfdfa'} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161615" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {withCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {ldItems.map((d) => <JsonLd data={d} />)}
    <slot name="head" />
    {
      ADS_ON && adNetwork && (
        <script is:inline define:vars={{ adNetwork }}>
          (function () {
            var done = false;
            function load() {
              if (done) return;
              done = true;
              window.__cfbAds = { network: adNetwork, ready: true };
              document.dispatchEvent(new CustomEvent('cfb:ads-ready', { detail: { network: adNetwork } }));
            }
            ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) {
              addEventListener(e, load, { once: true, passive: true });
            });
            setTimeout(load, 3000);
          })();
        </script>
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-chip bg-accent-fill px-4 py-2 font-semibold text-on-accent focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >Skip to content</a
    >
    <SiteHeader current={current} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter week={week} />
  </body>
</html>
